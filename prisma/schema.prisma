generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ATIVO
  TRIAL
  CANCELADO
  VENCIDO
}

enum BillingProvider {
  MANUAL
  STRIPE
  MERCADO_PAGO
}

enum UserRole {
  USER
  ADMIN
}

enum AccountType {
  PATIENT
  PROFESSIONAL
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum CabinClass {
  ECONOMY
  BUSINESS
}

enum Program {
  LATAM_PASS
  SMILES
  AZUL_FIDELIDADE
  TAP_MILES_GO
  LIVELO
  ESFERA
  C6_ATOMOS
}

enum Gender {
  FEMININO
  MASCULINO
  OUTRO
}

enum GenderPreference {
  FEMININO
  MASCULINO
  QUALQUER
}

enum ProfessionalType {
  CUIDADOR
  TECNICO_ENFERMAGEM
  ENFERMEIRO
  FISIOTERAPEUTA
}

enum ProfessionalVerificationStatus {
  PENDENTE
  EM_ANALISE
  APROVADO
  REPROVADO
}

enum CareService {
  BANHO
  TRANSFERENCIA
  MEDICACAO
  CURATIVOS
  FISIOTERAPIA
  COMPANHIA
  REFEICAO
  SINAIS_VITAIS
  AVALIACAO
  FORTALECIMENTO
  OUTRO
}

enum TransferSupportLevel {
  MODERADO
  ALTO
  DUPLA
}

enum DocumentType {
  RG
  CNH
  CPF
  COMPROVANTE_RESIDENCIA
  COREN
  CREFITO
  CERTIFICADO
  REFERENCIA
}

enum VerificationStatus {
  PENDENTE
  VERIFICADO
  RECUSADO
}

enum CareRequestStatus {
  RASCUNHO
  ENVIADO
  ACEITO
  AGENDADO
  CONCLUIDO
  CANCELADO
}

enum ProfessionalInquiryStatus {
  ABERTA
  RESPONDIDA
  ARQUIVADA
}

model User {
  id                      String                       @id @default(cuid())
  name                    String
  email                   String                       @unique
  passwordHash            String
  role                    UserRole                     @default(USER)
  accountType             AccountType                  @default(PATIENT)
  subscriptionTier        SubscriptionTier             @default(FREE)
  subscriptionStatus      SubscriptionStatus           @default(ATIVO)
  subscriptionProvider    BillingProvider              @default(MANUAL)
  subscriptionStartedAt   DateTime                     @default(now())
  subscriptionTrialEndsAt DateTime?
  subscriptionRenewsAt    DateTime?
  subscriptionCanceledAt  DateTime?
  billingCustomerId       String?                      @unique
  billingSubscriptionId   String?                      @unique
  monthlySearches         Int                          @default(0)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  favorites               Favorite[]
  professionalFavorites   ProfessionalFavorite[]
  careNotifications       CareNotification[]
  careMessages            CareMessage[]
  inquiryMessages         ProfessionalInquiryMessage[]
  passwordResetTokens     PasswordResetToken[]
  alerts                  Alert[]
  patientProfile          PatientProfile?
  professionalProfile     ProfessionalProfile?
  oauthAccounts           OAuthAccount[]

  @@index([subscriptionTier, subscriptionStatus])
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PatientProfile {
  id                  String               @id @default(cuid())
  userId              String               @unique
  phone               String?
  city                String               @default("Porto Alegre")
  neighborhood        String
  addressLine         String?
  addressNumber       String?
  addressComplement   String?
  postalCode          String?
  state               String?
  latitude            Decimal?             @db.Decimal(9, 6)
  longitude           Decimal?             @db.Decimal(9, 6)
  approximateWeightKg Int?
  mobilityNotes       String?
  preferredGender     GenderPreference     @default(FEMININO)
  transferNeed        TransferSupportLevel @default(ALTO)
  photoUrl             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  careRequests        CareRequest[]
  reviews             CareReview[]
  inquiries           ProfessionalInquiry[]
}

model ProfessionalProfile {
  id                             String                         @id @default(cuid())
  userId                         String                         @unique
  professionalType               ProfessionalType
  gender                         Gender
  age                            Int
  phone                          String?
  whatsappPhone                  String?
  city                           String                         @default("Porto Alegre")
  neighborhood                   String
  addressLine                    String?
  addressNumber                  String?
  addressComplement              String?
  postalCode                     String?
  state                          String?
  latitude                       Decimal                        @db.Decimal(9, 6)
  longitude                      Decimal                        @db.Decimal(9, 6)
  serviceRadiusKm                Int                            @default(8)
  hourlyRate                     Decimal                        @db.Decimal(10, 2)
  sessionRate                    Decimal?                       @db.Decimal(10, 2)
  cpf                            String?
  professionalRegistrationNumber String?
  professionalRegistrationUf     String?
  verificationStatus             ProfessionalVerificationStatus @default(PENDENTE)
  verificationNote               String?
  verificationReviewedAt         DateTime?
  photoUrl                       String?
  acceptsTravel                  Boolean                        @default(false)
  hasPassport                    Boolean                        @default(false)
  hasUsVisa                      Boolean                        @default(false)
  travelNotes                    String?
  bio                            String
  mobilitySupport                String
  supportLevel                   TransferSupportLevel
  services                       CareService[]
  rating                         Decimal                        @default(0) @db.Decimal(3, 2)
  reviewCount                    Int                            @default(0)
  responseMinutes                Int                            @default(15)
  isVerified                     Boolean                        @default(false)
  isActive                       Boolean                        @default(true)
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  user                           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents                      ProfessionalDocument[]
  availability                   AvailabilitySlot[]
  careRequests                   CareRequest[]
  inquiries                      ProfessionalInquiry[]
  favoritedBy                    ProfessionalFavorite[]
  reviews                        CareReview[]

  @@index([professionalType])
  @@index([gender])
  @@index([neighborhood])
  @@index([isActive])
}

model ProfessionalFavorite {
  id             String              @id @default(cuid())
  userId         String
  professionalId String
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalId])
  @@index([professionalId])
}

model ProfessionalDocument {
  id                     String              @id @default(cuid())
  professionalId         String
  type                   DocumentType
  status                 VerificationStatus  @default(PENDENTE)
  label                  String
  documentNumber         String?
  fileUrl                String?
  storagePath            String?
  fileName               String?
  mimeType               String?
  fileSize               Int?
  consentAccepted        Boolean             @default(false)
  consentAcceptedAt      DateTime?
  externalCheckStatus    String?
  externalCheckSource    String?
  externalCheckMessage   String?
  externalCheckCheckedAt DateTime?
  expiresAt              DateTime?
  reviewNote             String?
  reviewedAt             DateTime?
  createdAt              DateTime            @default(now())
  professional           ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([status])
}

model AdminAuditLog {
  id                   String   @id @default(cuid())
  adminUserId          String
  targetProfessionalId String?
  documentId           String?
  action               String
  previousStatus       String?
  nextStatus           String?
  note                 String?
  metadata             Json?
  createdAt            DateTime @default(now())

  @@index([adminUserId])
  @@index([targetProfessionalId])
  @@index([documentId])
  @@index([createdAt])
}

model AvailabilitySlot {
  id             String              @id @default(cuid())
  professionalId String
  weekday        Int
  startTime      String
  endTime        String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
}

model CareRequest {
  id                String               @id @default(cuid())
  patientProfileId  String?
  professionalId    String
  requesterName     String
  requesterEmail    String?
  requesterPhone    String?
  service           CareService
  supportNeed       TransferSupportLevel
  preferredGender   GenderPreference
  scheduledFor      DateTime?
  scheduledEndAt    DateTime?
  completionAvailableAt DateTime?
  completedAt       DateTime?
  completedById     String?
  durationHours     Decimal              @default(2) @db.Decimal(4, 2)
  addressLine       String
  addressNumber     String?
  addressComplement String?
  postalCode        String?
  neighborhood      String
  city              String               @default("Porto Alegre")
  state             String?
  latitude          Decimal?             @db.Decimal(9, 6)
  longitude         Decimal?             @db.Decimal(9, 6)
  notes             String?
  travelRequested   Boolean              @default(false)
  travelDestination String?
  isInternationalTravel Boolean           @default(false)
  needsUsVisa       Boolean               @default(false)
  travelNotes       String?
  rulesAcceptedAt   DateTime?
  rulesVersion      String?
  paymentAgreement  String                @default("DIRECT_WITH_PROFESSIONAL")
  status            CareRequestStatus     @default(ENVIADO)
  patientArchivedAt DateTime?
  professionalArchivedAt DateTime?
  patientDeletedAt  DateTime?
  professionalDeletedAt DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  patientProfile    PatientProfile?       @relation(fields: [patientProfileId], references: [id], onDelete: SetNull)
  professional      ProfessionalProfile   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  notifications     CareNotification[]
  messages          CareMessage[]
  review            CareReview?

  @@index([professionalId, status])
  @@index([professionalId, professionalArchivedAt, createdAt])
  @@index([professionalId, professionalDeletedAt, createdAt])
  @@index([patientProfileId])
  @@index([patientProfileId, patientArchivedAt, createdAt])
  @@index([patientProfileId, patientDeletedAt, createdAt])
  @@index([scheduledFor])
  @@index([completionAvailableAt])
}

model CareMessage {
  id            String       @id @default(cuid())
  careRequestId String
  senderId      String
  body          String
  readAt        DateTime?
  createdAt     DateTime     @default(now())
  careRequest   CareRequest  @relation(fields: [careRequestId], references: [id], onDelete: Cascade)
  sender        User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([careRequestId, createdAt])
  @@index([senderId])
  @@index([readAt])
}

model ProfessionalInquiry {
  id                     String                    @id @default(cuid())
  patientProfileId       String?
  professionalId         String
  requesterName          String
  requesterEmail         String?
  requesterPhone         String?
  status                 ProfessionalInquiryStatus @default(ABERTA)
  patientArchivedAt      DateTime?
  professionalArchivedAt DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  patientProfile         PatientProfile?           @relation(fields: [patientProfileId], references: [id], onDelete: SetNull)
  professional           ProfessionalProfile       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  messages               ProfessionalInquiryMessage[]

  @@index([professionalId, status, updatedAt])
  @@index([patientProfileId, status, updatedAt])
  @@index([requesterEmail, updatedAt])
}

model ProfessionalInquiryMessage {
  id          String              @id @default(cuid())
  inquiryId   String
  senderId    String?
  senderName  String
  senderEmail String?
  body        String
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  inquiry     ProfessionalInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender      User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([inquiryId, createdAt])
  @@index([senderId])
  @@index([readAt])
}

model CareReview {
  id               String              @id @default(cuid())
  careRequestId    String              @unique
  patientProfileId String?
  professionalId   String
  rating           Int
  comment          String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  careRequest      CareRequest         @relation(fields: [careRequestId], references: [id], onDelete: Cascade)
  patientProfile   PatientProfile?     @relation(fields: [patientProfileId], references: [id], onDelete: SetNull)
  professional     ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, createdAt])
  @@index([patientProfileId])
}

model CareNotification {
  id            String       @id @default(cuid())
  userId        String
  careRequestId String?
  type          String
  title         String
  body          String
  actionUrl     String?
  readAt        DateTime?
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  careRequest   CareRequest? @relation(fields: [careRequestId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, archivedAt, createdAt])
  @@index([careRequestId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AwardOffer {
  id            String         @id @default(cuid())
  origin        String
  destination   String
  departureDate DateTime
  returnDate    DateTime?
  cabinClass    CabinClass
  program       Program
  milesRequired Int
  taxesAmount   Decimal        @db.Decimal(10, 2)
  cashPrice     Decimal        @db.Decimal(10, 2)
  affiliateUrl  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  priceHistory  PriceHistory[]
  favorites     Favorite[]
  alerts        Alert[]
}

model PriceHistory {
  id          String     @id @default(cuid())
  offerId     String
  recordedAt  DateTime   @default(now())
  milesValue  Int
  taxesAmount Decimal    @db.Decimal(10, 2)
  offer       AwardOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String     @id @default(cuid())
  userId    String
  offerId   String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer     AwardOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
}

model Alert {
  id          String     @id @default(cuid())
  userId      String
  offerId     String
  targetMiles Int
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer       AwardOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
}
